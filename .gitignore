# Segredos — NUNCA commitar.
# Um .env vazado dá a qualquer pessoa a sessão do seu WhatsApp e o seu banco.
.env
.env.*

# Exceção: o .env.example é só um MODELO, sem valor real nenhum.
# Sem esta linha o padrão ".env.*" acima o bloquearia junto com os de verdade.
!.env.example

*.pem
*.key

# Sessão local do Baileys (em produção ela vive no MongoDB)
auth_info*/
baileys_store*

node_modules/
npm-debug.log*
.DS_Store
