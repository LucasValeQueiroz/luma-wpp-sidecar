# =====================================================================
#  Modelo de variáveis de ambiente do Luma WPP Sidecar.
#  Copie para .env ao rodar local. NO RENDER, use o painel Environment.
#  O arquivo .env está no .gitignore — nunca o envie para o GitHub.
# =====================================================================

# Connection string do MongoDB Atlas (onde a sessão do WhatsApp é salva).
# ⚠️ Quem tem esta string tem a sua sessão do WhatsApp. Usuário exclusivo, senha forte.
MONGO_URI=mongodb+srv://usuario:senha@cluster.mongodb.net/?retryWrites=true&w=majority

# Chave que protege TODAS as rotas /api. Mínimo 20 caracteres.
# Gere uma com:  openssl rand -hex 32
# O MESMO valor precisa estar no Apps Script em:
#   Configurações do projeto > Propriedades do script > SIDECAR_API_KEY
API_SECRET=troque-isto-por-uma-chave-longa-e-aleatoria

# Porta local. No Render é definida automaticamente — não precisa mexer.
PORT=3000
