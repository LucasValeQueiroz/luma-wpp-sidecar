# =====================================================================
#  Modelo de variáveis de ambiente do Luma WPP Sidecar (v3).
#  Copie para .env ao rodar local. NO RENDER, use o painel Environment.
#  O arquivo .env está no .gitignore — nunca o envie para o GitHub.
# =====================================================================

# Connection string do MongoDB Atlas (onde a sessão do WhatsApp é salva).
# ⚠️ Quem tem esta string tem a sua sessão do WhatsApp. Usuário exclusivo, senha forte.
MONGO_URI=mongodb+srv://usuario:senha@cluster.mongodb.net/?retryWrites=true&w=majority

# Chave que protege TODAS as rotas /api. Mínimo 20 caracteres.
# Gere uma com:  openssl rand -hex 32
# O MESMO valor precisa estar no Apps Script em:
#   Configurações do projeto > Propriedades do script > SIDECAR_API_KEY
API_SECRET=troque-isto-por-uma-chave-longa-e-aleatoria

# Porta local. No Render é definida automaticamente — não precisa mexer.
PORT=3000

# ---------------------------------------------------------------------
#  FILA DE ENVIO ANTI-BAN (opcionais — o painel do CRM também ajusta)
#  Valores salvos pelo painel ficam no Mongo e têm prioridade sobre estes.
# ---------------------------------------------------------------------
# Intervalo aleatório entre duas publicações (segundos)
ENVIO_INTERVALO_MIN_SEG=25
ENVIO_INTERVALO_MAX_SEG=60
# Tetos (janela móvel: última hora / últimas 24h / por grupo em 24h)
ENVIO_MAX_POR_HORA=40
ENVIO_MAX_POR_DIA=250
ENVIO_MAX_POR_GRUPO_DIA=15
# Janela em que o auxiliar pode postar (fora dela, só envios manuais)
ENVIO_JANELA_INICIO=08:00
ENVIO_JANELA_FIM=21:30
# Segundos de "digitando..." antes de cada publicação
ENVIO_DIGITANDO_SEG=3
# Fuso usado na janela de horário
TZ_ENVIO=America/Sao_Paulo

# ---------------------------------------------------------------------
#  EMBEDDED SIGNUP / COEXISTENCE (opcionais — só para /conectar)
# ---------------------------------------------------------------------
# META_APP_ID=
# META_APP_SECRET=
# META_CONFIG_ID=
# APPS_SCRIPT_URL=https://script.google.com/macros/s/SEU_ID/exec
# APPS_SCRIPT_SECRET=   (se vazio, usa a própria API_SECRET)
# GRAPH_VERSION=v23.0
